<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces the blanket android:usesCleartextTraffic="true" that the app
  previously declared on <application>.

  Plain HTTP is now permitted ONLY for the local development hosts the
  FastAPI backend runs on. Everything else - including whatever host
  API_BASE_URL points at in production - must be HTTPS.

  Add your LAN IP below if you test on a physical device against a dev
  machine, e.g. flutter run dart-define=API_BASE_URL=http://192.168.1.20:8000
-->
<network-security-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator loopback to the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Desktop / iOS simulator -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.56.1</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false"/>

</network-security-config>